{
	"name": "n8n-nodes-timetopost",
	"version": "0.1.1",
	"description": "n8n community node for TimeToPost: create approval-gated drafts, schedule posts, and list posts and connected accounts.",
	"license": "MIT",
	"homepage": "https://timetopost.co/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"timetopost",
		"social-media",
		"scheduler"
	],
	"author": {
		"name": "TimeToPost",
		"email": "hello@timetopost.co"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MelMayssonOwen/n8n-nodes-timetopost.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TimeToPostApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TimeToPost/TimeToPost.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/jest": "^29.5.14",
		"eslint": "9.39.4",
		"jest": "^29.7.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"ts-jest": "^29.2.5",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/MelMayssonOwen/n8n-nodes-timetopost/issues"
	}
}
